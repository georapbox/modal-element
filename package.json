{
  "name": "@georapbox/modal-element",
  "version": "1.11.2",
  "description": "A custom element to create a modal, using the native dialog element under the hood.",
  "type": "module",
  "main": "dist/modal-element.js",
  "unpkg": "dist/modal-element.js",
  "types": "dist/modal-element.d.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/modal-element.d.ts",
      "import": "./dist/modal-element.js"
    },
    "./define": {
      "types": "./dist/modal-element.d.ts",
      "import": "./dist/modal-element-defined.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "files": [
    "/src",
    "/dist"
  ],
  "scripts": {
    "start": "npm-run-all --parallel \"serve:dev -- {1}\" dev",
    "dev": "npm-run-all clean dev:esbuild",
    "dev:esbuild": "node ./scripts/dev.mjs",
    "serve:dev": "web-dev-server --node-resolve --open /docs/ --watch",
    "build": "npm-run-all clean build:esbuild",
    "build:esbuild": "node ./scripts/build.mjs",
    "build:docs": "npm-run-all build build:docs:copy",
    "build:docs:copy": "node ./scripts/copy-build-to-docs.mjs",
    "test": "web-test-runner",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "npm run test -- --coverage",
    "lint": "eslint",
    "format": "prettier --ignore-unknown --write .",
    "types": "tsc --project tsconfig.json",
    "analyze": "custom-elements-manifest analyze",
    "clean": "rimraf dist",
    "prepublishOnly": "npm-run-all clean lint test build types analyze"
  },
  "keywords": [
    "custom element",
    "web component",
    "modal",
    "dialog"
  ],
  "author": {
    "name": "George Raptis",
    "email": "georapbox@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georapbox/modal-element.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/georapbox/modal-element/issues"
  },
  "homepage": "https://github.com/georapbox/modal-element#readme",
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "~0.11.0",
    "@eslint/js": "~10.0.1",
    "@esm-bundle/chai": "~4.3.4-fix.0",
    "@open-wc/testing": "~5.0.0",
    "@types/node": "~26.6.5",
    "@web/dev-server": "~1.0.0",
    "@web/test-runner": "~1.0.0",
    "@web/test-runner-playwright": "~1.0.0",
    "esbuild": "~0.28.2",
    "eslint": "~10.13.0",
    "eslint-plugin-wc": "~3.1.0",
    "globals": "~17.13.0",
    "npm-run-all": "~4.1.5",
    "playwright": "~1.64.1",
    "prettier": "~3.9.10",
    "rimraf": "~6.1.3",
    "sinon": "~22.1.0",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
